---
type Entry = {
  title: string;
  description: string;
  url: string;
  kind: string;
  keywords?: string;
};
type Props = { entries: Entry[]; searchUrl: string };
const { entries, searchUrl } = Astro.props;
---

<dialog
  id="explore-dialog"
  class="explore-dialog"
  aria-labelledby="explore-title"
  aria-describedby="explore-description"
>
  <div class="explore-heading">
    <div>
      <p class="eyebrow">FIND YOUR NEXT IDEA</p><h2 id="explore-title">
        从好奇的地方开始。
      </h2>
    </div>
    <form method="dialog">
      <button class="close-dialog" aria-label="关闭快速探索">×</button>
    </form>
  </div>
  <p id="explore-description">搜索作品、数学笔记与 AI 学习路径。</p>
  <label for="explore-input" class="sr-only">搜索作品与笔记</label>
  <input
    id="explore-input"
    type="search"
    placeholder="试试 AI、矩阵，或一个作品的名字…"
    autocomplete="off"
  />
  <div class="explore-suggestions" aria-label="推荐搜索">
    <button type="button" data-explore-query="AI">AI 探索</button>
    <button type="button" data-explore-query="线性代数">线性代数</button>
    <button type="button" data-explore-query="作品">所有作品</button>
    <button type="button" data-explore-query="">全部</button>
  </div>
  <p id="explore-count" class="result-count" role="status" aria-live="polite">
    共 {entries.length} 个入口
  </p>
  <ul class="explore-results">
    {
      entries.map(entry => (
        <li
          data-explore-entry
          data-search={`${entry.title} ${entry.description} ${entry.kind} ${entry.keywords ?? ""}`.toLocaleLowerCase()}
        >
          <a href={entry.url}>
            <>
              <span class="result-kind">{entry.kind}</span>
              <span class="result-content">
                <>
                  <strong>{entry.title}</strong>
                  <small>{entry.description}</small>
                </>
              </span>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        </li>
      ))
    }
  </ul>
  <div id="explore-empty" class="explore-empty" hidden>
    <p>还没有找到相关内容。</p><a href={searchUrl}>试试全文搜索 →</a>
  </div>
  <p class="explore-footnote">站内内容检索 · <kbd>Esc</kbd> 关闭</p>
</dialog>

<script>
  let controller: AbortController | undefined;
  function setupExplore() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const dialog = document.querySelector<HTMLDialogElement>("#explore-dialog");
    const input = document.querySelector<HTMLInputElement>("#explore-input");
    if (!dialog || !input) return;
    const entries = Array.from(
      dialog.querySelectorAll<HTMLElement>("[data-explore-entry]")
    );
    const count = dialog.querySelector<HTMLElement>("#explore-count");
    const empty = dialog.querySelector<HTMLElement>("#explore-empty");
    let trigger: HTMLElement | null = null;
    function filter() {
      const words = input!.value
        .trim()
        .toLocaleLowerCase()
        .split(/\s+/)
        .filter(Boolean);
      let matches = 0;
      for (const entry of entries) {
        entry.hidden = !words.every(word =>
          entry.dataset.search?.includes(word)
        );
        if (!entry.hidden) matches++;
      }
      if (count) count.textContent = `找到 ${matches} 个入口`;
      if (empty) empty.hidden = matches !== 0;
    }
    function openExplore(element?: HTMLElement) {
      if (dialog!.open) return;
      trigger =
        element ??
        (document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null);
      input!.value = "";
      filter();
      dialog!.showModal();
      input!.focus();
    }
    document
      .querySelectorAll<HTMLButtonElement>("[data-open-explore]")
      .forEach(button => {
        button.hidden = false;
        button.addEventListener("click", () => openExplore(button), { signal });
      });
    input.addEventListener("input", filter, { signal });
    dialog
      .querySelectorAll<HTMLButtonElement>("[data-explore-query]")
      .forEach(button => {
        button.addEventListener(
          "click",
          () => {
            input.value = button.dataset.exploreQuery ?? "";
            filter();
            input.focus();
          },
          { signal }
        );
      });
    dialog.addEventListener(
      "click",
      event => {
        if (event.target === dialog) {
          const bounds = dialog.getBoundingClientRect();
          if (
            event.clientX < bounds.left ||
            event.clientX > bounds.right ||
            event.clientY < bounds.top ||
            event.clientY > bounds.bottom
          )
            dialog.close();
        }
      },
      { signal }
    );
    dialog.addEventListener("close", () => trigger?.focus(), { signal });
    dialog
      .querySelectorAll("a")
      .forEach(link =>
        link.addEventListener("click", () => dialog.close(), { signal })
      );
    document.addEventListener(
      "keydown",
      event => {
        if (event.isComposing || event.defaultPrevented) return;
        const target = event.target;
        if (
          target instanceof HTMLElement &&
          (target.isContentEditable ||
            target.closest("input, textarea, select"))
        )
          return;
        if (
          ((event.metaKey || event.ctrlKey) &&
            event.key.toLowerCase() === "k") ||
          (event.key === "/" &&
            !event.metaKey &&
            !event.ctrlKey &&
            !event.altKey)
        ) {
          event.preventDefault();
          openExplore();
        }
      },
      { signal }
    );
  }
  document.addEventListener("astro:page-load", setupExplore);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>

<style>
  .explore-dialog {
    width: min(40rem, calc(100% - 2rem));
    max-height: 85svh;
    margin: auto;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    padding: 1.75rem;
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 24px 100px #182e2626;
  }
  .explore-dialog::backdrop {
    background: #1b2f2666;
    backdrop-filter: blur(6px);
  }
  .explore-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .eyebrow {
    color: var(--accent);
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.6rem;
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  #explore-description {
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }
  .close-dialog {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    font-size: 1.4rem;
  }
  .close-dialog:hover {
    background: var(--muted);
  }
  input {
    width: 100%;
    border: 1px solid #cbd5c7;
    background: #fff;
    border-radius: 0.75rem;
    padding: 0.9rem 1rem;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    outline-color: var(--accent);
  }
  .explore-suggestions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0.8rem 0 1.2rem;
  }
  .explore-suggestions button {
    background: #edf1e9;
    border: 1px solid var(--border);
    border-radius: 2rem;
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
  }
  .explore-suggestions button:hover {
    background: #dce6d6;
  }
  .result-count {
    font-size: 0.72rem;
    color: var(--muted-foreground);
    margin-bottom: 0.5rem;
  }
  .explore-results {
    max-height: 35svh;
    overflow-y: auto;
  }
  .explore-results a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 0.4rem;
    border-bottom: 1px solid var(--border);
    border-radius: 0.4rem;
  }
  .explore-results a:hover {
    background: #edf1e9;
  }
  .result-kind {
    font-size: 0.65rem;
    white-space: nowrap;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.2rem 0.35rem;
  }
  .result-content {
    display: grid;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
  }
  .result-content strong {
    font-size: 0.85rem;
    font-weight: 500;
  }
  .result-content small {
    font-size: 0.72rem;
    color: var(--muted-foreground);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .explore-footnote {
    color: var(--muted-foreground);
    font-size: 0.65rem;
    text-align: right;
    padding-top: 1rem;
  }
  kbd {
    border: 1px solid var(--border);
    border-radius: 0.2rem;
    padding: 0.1rem 0.3rem;
  }
  .explore-empty {
    padding: 1rem 0;
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }
  .explore-empty a {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .explore-dialog {
      padding: 1.25rem;
    }
  }
</style>
