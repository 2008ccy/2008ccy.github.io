---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Card from "./Card.astro";
import Pagination from "./Pagination.astro";
import { getNextTagOptions } from "@/utils/filterPostPage";

type Props = {
  posts: CollectionEntry<"posts">[];
  page: Page<CollectionEntry<"posts">>;
  postsUrl: string;
};
const { posts, page, postsUrl } = Astro.props;
const tagEntries = posts.map(post => ({ tags: post.data.tags }));
const rootOptions = getNextTagOptions(tagEntries, []);
const depth = Math.max(1, ...posts.map(post => post.data.tags.length));
const levelNames = ["一级标签", "二级标签", "三级标签", "四级标签", "五级标签"];
---

<div
  data-post-list
  data-page-size={page.size}
  data-initial-page={page.currentPage}
  data-posts-url={postsUrl}
>
  <div class="tag-filter" data-filter-controls hidden>
    <p id="tag-filter-label">按标签逐级筛选</p>
    <div class="filter-options" role="group" aria-labelledby="tag-filter-label">
      {
        Array.from({ length: depth }, (_, index) => {
          const label = levelNames[index] ?? `第 ${index + 1} 级标签`;
          return (
            <div class="hierarchy-step">
              {index > 0 && (
                <span class="level-separator" aria-hidden="true">
                  ›
                </span>
              )}
              <label class="filter-level">
                <span>{label}</span>
                <select
                  data-tag-level={index}
                  aria-label={label}
                  disabled={index > 0}
                >
                  <option value="">
                    {index > 0 ? "请先选择上一级" : "全部"}
                  </option>
                  {index === 0 &&
                    rootOptions.map(option => (
                      <option value={option.label}>
                        {option.label} ({option.count})
                      </option>
                    ))}
                </select>
              </label>
            </div>
          );
        })
      }
    </div>
    <div class="summary-row">
      <p
        class="result-summary"
        data-filter-summary
        role="status"
        aria-live="polite"
      >
        共 {posts.length} 篇文章
      </p>
      <button type="button" data-clear-filter hidden>清除筛选</button>
    </div>
  </div>

  <ul data-post-items>
    {
      posts.map((post, index) => (
        <Card
          {...post}
          hidden={index < page.start || index >= page.start + page.size}
          filterTags={post.data.tags}
        />
      ))
    }
  </ul>
  <div class="empty-result" data-filter-empty hidden={posts.length > 0}>
    <p data-empty-message>文章正在准备中，欢迎稍后再来。</p>
  </div>

  <div data-static-pagination><Pagination {page} /></div>
  <nav
    class="filter-pagination"
    aria-label="文章分页"
    data-filter-pagination
    hidden
  >
    <button type="button" data-page-prev aria-label="上一页">← 上一页</button>
    <span data-page-label></span>
    <button type="button" data-page-next aria-label="下一页">下一页 →</button>
  </nav>
</div>

<script>
  import {
    filterPostPage,
    getNextTagOptions,
    parseTagPath,
    resolveLegacyTagPath,
  } from "@/utils/filterPostPage";

  let controller: AbortController | undefined;
  function setupPostList() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const root = document.querySelector<HTMLElement>("[data-post-list]");
    if (!root) return;

    const controls = root.querySelector<HTMLElement>("[data-filter-controls]")!;
    const selects = Array.from(
      root.querySelectorAll<HTMLSelectElement>("[data-tag-level]")
    );
    const entries = Array.from(
      root.querySelectorAll<HTMLElement>("[data-post-tags]")
    ).map(element => ({
      element,
      tags: parseTagPath(
        JSON.parse(element.dataset.postTags ?? "[]") as string[]
      ),
    }));
    const summary = root.querySelector<HTMLElement>("[data-filter-summary]")!;
    const empty = root.querySelector<HTMLElement>("[data-filter-empty]")!;
    const emptyMessage = root.querySelector<HTMLElement>(
      "[data-empty-message]"
    )!;
    const clear = root.querySelector<HTMLButtonElement>("[data-clear-filter]")!;
    const pagination = root.querySelector<HTMLElement>(
      "[data-filter-pagination]"
    )!;
    const previous = root.querySelector<HTMLButtonElement>("[data-page-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-page-next]")!;
    const pageLabel = root.querySelector<HTMLElement>("[data-page-label]")!;
    const pageSize = Number(root.dataset.pageSize) || 4;
    const initialPage = Number(root.dataset.initialPage) || 1;
    const postsUrl = root.dataset.postsUrl!;
    let currentPath: string[] = [];
    let currentPage = initialPage;

    function rememberList() {
      try {
        sessionStorage.setItem("backUrl", location.pathname + location.search);
      } catch {
        /* Browsing also works without session storage. */
      }
    }

    function render(selection: string[], page: number, updateUrl = false) {
      currentPath = parseTagPath(selection);
      const result = filterPostPage(entries, currentPath, page, pageSize);
      currentPage = result.currentPage;
      const visible = new Set(result.items.map(item => item.element));
      entries.forEach(({ element }) => {
        element.hidden = !visible.has(element);
      });
      selects.forEach((select, level) => {
        const ready = level <= currentPath.length;
        const options = ready
          ? getNextTagOptions(entries, currentPath.slice(0, level))
          : [];
        const placeholder = !ready
          ? "请先选择上一级"
          : level > 0 && options.length === 0
            ? "无下级标签"
            : "全部";
        select.replaceChildren(
          new Option(placeholder, ""),
          ...options.map(
            option =>
              new Option(`${option.label} (${option.count})`, option.label)
          )
        );
        const selected = currentPath[level] ?? "";
        if (selected && !options.some(option => option.label === selected))
          select.add(new Option(`${selected}（无匹配）`, selected));
        select.value = selected;
        select.disabled = !ready || options.length === 0;
      });
      summary.textContent =
        currentPath.length > 0
          ? `${currentPath.join(" › ")} · ${result.total} 篇文章`
          : `共 ${result.total} 篇文章`;
      empty.hidden = result.total !== 0;
      clear.hidden = currentPath.length === 0;
      emptyMessage.textContent =
        currentPath.length > 0
          ? "没有符合该标签层级的文章，请调整分类或清除筛选。"
          : "文章正在准备中，欢迎稍后再来。";
      pagination.hidden = result.lastPage <= 1;
      previous.disabled = result.currentPage <= 1;
      next.disabled = result.currentPage >= result.lastPage;
      pageLabel.textContent = `${result.currentPage} / ${result.lastPage}`;
      if (updateUrl) {
        const url = new URL(location.href);
        url.pathname = postsUrl;
        url.hash = "";
        url.searchParams.delete("tag");
        if (currentPath.length > 0)
          url.searchParams.set("tags", currentPath.join(","));
        else url.searchParams.delete("tags");
        if (result.currentPage > 1)
          url.searchParams.set("page", String(result.currentPage));
        else url.searchParams.delete("page");
        if (url.href !== location.href)
          history.pushState(history.state, "", url);
      }
      rememberList();
    }

    function readUrl() {
      const url = new URL(location.href);
      const selection = url.searchParams.has("tags")
        ? parseTagPath(url.searchParams.get("tags") ?? "")
        : resolveLegacyTagPath(entries, url.searchParams.get("tag") ?? "");
      const isMainList =
        url.pathname.replace(/\/+$/, "") === postsUrl.replace(/\/+$/, "");
      const page = url.searchParams.has("page")
        ? Number(url.searchParams.get("page"))
        : selection.length > 0 || isMainList
          ? 1
          : initialPage;
      render(selection, page);
    }

    selects.forEach((select, level) =>
      select.addEventListener(
        "change",
        () => {
          const selection = currentPath.slice(0, level);
          if (select.value) selection.push(select.value);
          render(selection, 1, true);
        },
        { signal }
      )
    );
    clear.addEventListener("click", () => render([], 1, true), { signal });
    previous.addEventListener(
      "click",
      () => {
        render(currentPath, currentPage - 1, true);
        root.scrollIntoView({ block: "start" });
      },
      { signal }
    );
    next.addEventListener(
      "click",
      () => {
        render(currentPath, currentPage + 1, true);
        root.scrollIntoView({ block: "start" });
      },
      { signal }
    );
    root.addEventListener(
      "click",
      event => {
        if (
          event.target instanceof Element &&
          event.target.closest("[data-post-tags] a")
        )
          rememberList();
      },
      { signal }
    );
    window.addEventListener("popstate", readUrl, { signal });
    readUrl();
    controls.hidden = false;
    root.querySelector<HTMLElement>("[data-static-pagination]")!.hidden = true;
  }

  document.addEventListener("astro:page-load", setupPostList);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>

<style>
  [data-post-list] {
    scroll-margin-top: 1.5rem;
  }
  .tag-filter {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }
  #tag-filter-label {
    font-size: 0.85rem;
    color: var(--muted-foreground);
    margin-bottom: 0.85rem;
  }
  .filter-options {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .hierarchy-step {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    min-width: 0;
  }
  .filter-level {
    display: grid;
    gap: 0.4rem;
    font-size: 0.8rem;
  }
  .filter-level > span {
    color: var(--muted-foreground);
  }
  .filter-level select {
    width: 10.5rem;
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--background);
    color: var(--foreground);
    padding: 0.5rem 0.6rem;
    font-size: 0.85rem;
  }
  .filter-level select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .filter-level select:disabled {
    color: var(--muted-foreground);
    background: #f6f6f6;
  }
  .level-separator {
    color: var(--muted-foreground);
    padding-bottom: 0.4rem;
    font-size: 1.2rem;
  }
  .summary-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }
  .result-summary {
    color: var(--muted-foreground);
    font-size: 0.8rem;
  }
  [data-clear-filter] {
    flex-shrink: 0;
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  .empty-result {
    color: var(--muted-foreground);
    padding-block: 1.5rem;
    font-size: 0.9rem;
  }
  .filter-pagination:not([hidden]) {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-block: 2rem;
    font-size: 0.9rem;
  }
  .filter-pagination button {
    padding: 0.3rem 0.25rem;
  }
  .filter-pagination button:disabled {
    opacity: 0.45;
    cursor: default;
  }
  @media (max-width: 600px) {
    .filter-options {
      gap: 0.65rem;
    }
    .hierarchy-step {
      flex: 1 1 9rem;
      gap: 0.5rem;
    }
    .filter-level {
      flex: 1;
      min-width: 0;
    }
    .filter-level select {
      width: 100%;
      min-width: 0;
    }
  }
</style>
