---
import { getCollection, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const home = await getEntry("pages", "home");
if (!home) throw new Error("缺少 pages/home.md");
const { Content } = await render(home);
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter(project => project.data.featured);
const visibleProjects =
  featuredProjects.length > 0 ? featuredProjects : projects;
const posts = getSortedPosts(await getCollection("posts"));
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: config.site.timezone,
});
---

<Layout
  title={`${home.data.title}｜${config.site.title}`}
  description={home.data.description}
>
  <Header />
  <main id="main-content" class="app-layout home" data-home-path={url("")}>
    <section class="intro" aria-labelledby="intro-heading">
      <h1 id="intro-heading">{home.data.title}</h1>
      <div class="intro-copy"><Content /></div>
      <div class="intro-links">
        <a href={config.site.profile}>GitHub ↗</a><a href={url("contact")}
          >联系我</a
        >
      </div>
    </section>

    <section aria-labelledby="projects-heading">
      <div class="section-heading">
        <h2 id="projects-heading">作品</h2><a href={url("projects")}
          >全部作品 →</a
        >
      </div>
      {
        visibleProjects.length > 0 ? (
          <ul class="project-list">
            {visibleProjects.slice(0, 4).map(project => (
              <li>
                <h3>
                  <a href={url(`projects/${project.id}`)}>
                    {project.data.title}
                  </a>
                </h3>
                <p>{project.data.description}</p>
                {project.data.status && (
                  <p class="project-status">{project.data.status}</p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-copy">作品正在整理中。</p>
        )
      }
    </section>

    <section aria-labelledby="posts-heading">
      <div class="section-heading">
        <h2 id="posts-heading">近期文章</h2><a href={url("posts")}>全部文章 →</a
        >
      </div>
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.slice(0, config.posts.perIndex).map(post => (
              <li>
                <a href={getPostUrl(post.id, post.filePath, locale)}>
                  <h3>{post.data.title}</h3>
                  <time datetime={post.data.pubDatetime.toISOString()}>
                    {dateFormatter.format(post.data.pubDatetime)}
                  </time>
                </a>
                <p>{post.data.description}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-copy">文章正在准备中。</p>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const homePath =
      document.querySelector<HTMLElement>("[data-home-path]")?.dataset.homePath;
    if (homePath) {
      try {
        sessionStorage.setItem("backUrl", homePath);
      } catch {
        /* The page also works without browser storage. */
      }
    }
  });
</script>

<style>
  .home {
    padding-bottom: 2.5rem;
  }
  .intro {
    padding-block: 3.5rem 2.5rem;
  }
  h1 {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .intro-copy {
    max-width: 40rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.9;
    margin-top: 1rem;
  }
  .intro-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  section + section {
    border-top: 1px solid var(--border);
    padding-top: 1.75rem;
    margin-top: 1.75rem;
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  h2 {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .section-heading > a {
    color: var(--muted-foreground);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
  }
  h3 {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.7;
  }
  .project-list p,
  .post-list p,
  .empty-copy {
    color: var(--muted-foreground);
    font-size: 0.85rem;
    line-height: 1.85;
    margin-top: 0.5rem;
  }
  .post-list li + li {
    margin-top: 1.4rem;
  }
  .post-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
  }
  time {
    flex-shrink: 0;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 600px) {
    .intro {
      padding-top: 2.5rem;
      padding-bottom: 1.5rem;
    }
    h1 {
      font-size: 1.75rem;
    }
    .project-list {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .post-list a {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
