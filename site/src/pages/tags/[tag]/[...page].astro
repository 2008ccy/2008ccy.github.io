---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { GetStaticPathsOptions } from "astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import config from "@/config";

// Keep existing shared tag URLs working through the article-page filters.
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = getSortedPosts(await getCollection("posts"));
  return getUniqueTags(posts).flatMap(({ tag }) =>
    paginate(
      posts.filter(post => slugifyAll(post.data.tags).includes(tag)),
      {
        params: { tag },
        pageSize: config.posts.perPage,
      }
    )
  );
}

const locale = Astro.currentLocale ?? config.site.lang;
const page = Astro.props.page.currentPage;
const query = new URLSearchParams({ tag: Astro.params.tag ?? "" });
if (page > 1) query.set("page", String(page));
return Astro.redirect(`${getRelativeLocaleUrl(locale, "posts")}?${query}`);
---
