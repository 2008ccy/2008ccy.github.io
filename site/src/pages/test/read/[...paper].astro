---
import type { GetStaticPaths } from "astro";
import { readFile, access } from "node:fs/promises";
import { resolve } from "node:path";
import { createHash } from "node:crypto";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import {
  examPapers,
  examSubjects,
  type ExamPaper,
} from "../../../../scripts/exam-papers.mjs";
import config from "@/config";

type Page = { src: string; width?: number; height?: number };
type Answer = Page & {
  id: string;
  label: string;
  sourcePages: number[];
  sha256: string;
};
type Reading = {
  sha256: string;
  answersStart?: number;
  pages: Page[];
  answers?: Answer[];
  answerSource?: string;
  answerLicense?: string;
};
type Props = { paper: ExamPaper; reading: Reading };

export const getStaticPaths: GetStaticPaths = async () => {
  const root = resolve(process.cwd(), "..");
  const publicRoot = resolve(root, "site/public");
  const manifest: Record<string, Reading> = JSON.parse(
    await readFile(resolve(publicRoot, "exams/manifest.json"), "utf8")
  );
  return Promise.all(
    (await examPapers(root))
      .filter(paper => !paper.hidden)
      .map(async paper => {
        let reading = manifest[paper.route];
        if (paper.mediaType === "application/pdf") {
          const digest = createHash("sha256")
            .update(await readFile(paper.source))
            .digest("hex");
          if (!reading || reading.sha256 !== digest || !reading.pages.length)
            throw new Error(
              `请先运行 scripts/render-exam-pages.py 更新试卷阅读页：${paper.route}`
            );
          if (!reading.answers?.length)
            throw new Error(`缺少逐题答案截图：${paper.route}`);
          const ids = new Set<string>();
          await Promise.all(
            reading.answers.map(async answer => {
              if (ids.has(answer.id))
                throw new Error(`重复题号：${paper.route} ${answer.id}`);
              ids.add(answer.id);
              if (
                !answer.src.startsWith(
                  `exams/${digest.slice(0, 16)}/answers-v1/`
                ) ||
                !answer.width ||
                !answer.height
              )
                throw new Error(`无效答案截图：${paper.route} ${answer.id}`);
              const image = await readFile(resolve(publicRoot, answer.src));
              if (
                createHash("sha256").update(image).digest("hex") !==
                answer.sha256
              )
                throw new Error(
                  `答案截图校验失败：${paper.route} ${answer.id}`
                );
            })
          );
          if (reading.answerLicense)
            await access(resolve(publicRoot, reading.answerLicense));
        } else {
          reading = {
            sha256: "",
            pages: [
              {
                src: `test/files/${paper.route.split("/").map(encodeURIComponent).join("/")}`,
              },
            ],
          };
        }
        return {
          params: { paper: paper.readerRoute },
          props: { paper, reading },
        };
      })
  );
};

const { paper, reading } = Astro.props;
const subject = examSubjects.find(subject => subject.id === paper.subject)!;
const testUrl = getAssetPath("test/");
const pdfUrl = getAssetPath(
  `test/files/${paper.route.split("/").map(encodeURIComponent).join("/")}`
);
const answers = reading.answers ?? [];
// Keep old page bookmarks useful: an answer-page bookmark lands on its first answer.
const pageAnchors = new Map<string, number[]>();
for (
  let page = reading.answersStart ?? 1;
  page <= reading.pages.length;
  page++
) {
  const answer = answers.find(answer => answer.sourcePages.includes(page));
  if (answer)
    pageAnchors.set(answer.id, [...(pageAnchors.get(answer.id) ?? []), page]);
}
---

<PostLayout
  title={`${paper.title}｜${config.site.title}`}
  description={`${paper.title}参考答案，按题号查看${answers.length}道题的详细解答。`}
>
  <Header />
  <nav class="app-layout breadcrumb mt-8 mb-6" aria-label="面包屑">
    <a href={getAssetPath("")}>首页</a><span aria-hidden="true">»</span>
    <a href={testUrl}>题库</a><span aria-hidden="true">»</span>
    <span aria-current="page">{paper.title}</span>
  </nav>
  <main id="main-content" class="app-layout pb-8" data-pagefind-body>
    <h1 class="text-accent text-2xl font-bold sm:text-3xl">{paper.title}</h1>
    <div class="reading-meta">
      <p>{subject.title} · 参考答案 · {answers.length} 题</p>
      {
        paper.mediaType === "application/pdf" && (
          <a class="pdf-download" href={pdfUrl} download={`${paper.title}.pdf`}>
            下载试卷与答案 PDF ↓
          </a>
        )
      }
    </div>
    {
      answers.length > 0 && (
        <nav class="answer-nav" aria-label="按题号查看答案">
          <span class="nav-label">题号</span>
          <div class="question-links">
            {answers.map(answer => (
              <a
                href={`#answer-${answer.id}`}
                aria-label={`查看${answer.label}答案`}
              >
                {answer.id === "extra" ? "附加题" : answer.id}
              </a>
            ))}
          </div>
        </nav>
      )
    }
    <article aria-label={`${paper.title}参考答案`}>
      {
        answers.map((answer, index) => (
          <section
            id={`answer-${answer.id}`}
            class="answer-card"
            aria-labelledby={`answer-${answer.id}-heading`}
          >
            {(pageAnchors.get(answer.id) ?? []).map(page => (
              <span
                id={`page-${page}`}
                class="legacy-anchor"
                aria-hidden="true"
              />
            ))}
            <div class="answer-heading">
              <h2 id={`answer-${answer.id}-heading`}>{answer.label}</h2>
              <a
                href={getAssetPath(answer.src)}
                target="_blank"
                rel="noopener"
                aria-label={`单独查看${answer.label}答案图`}
              >
                单题查看 ↗
              </a>
            </div>
            <a
              class="answer-image-link"
              href={getAssetPath(answer.src)}
              target="_blank"
              rel="noopener"
              aria-label={`放大${answer.label}答案图`}
            >
              <img
                src={getAssetPath(answer.src)}
                width={answer.width}
                height={answer.height}
                alt={`${paper.title}，${answer.label}解答`}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </a>
          </section>
        ))
      }
      {
        !answers.length &&
          reading.pages.map((page, index) => (
            <section id={`page-${index + 1}`} class="answer-card">
              <img
                src={getAssetPath(page.src)}
                width={page.width}
                height={page.height}
                alt={paper.title}
              />
            </section>
          ))
      }
    </article>
    {
      (reading.answerSource || reading.answerLicense) && (
        <p class="answer-credit">
          {reading.answerSource && (
            <a href={reading.answerSource} target="_blank" rel="noopener">
              答案来源 ↗
            </a>
          )}
          {reading.answerLicense && (
            <a
              href={getAssetPath(reading.answerLicense)}
              target="_blank"
              rel="noopener"
            >
              来源与许可 ↗
            </a>
          )}
        </p>
      )
    }
    <nav class="reading-footer" aria-label="阅读导航">
      <a href={`${testUrl}#${paper.subject}`}>← 返回{subject.title}题库</a>
      <a href="#main-content">回到顶部 ↑</a>
    </nav>
  </main>
  <Footer />
</PostLayout>

<style>
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted-foreground);
  }
  .reading-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block: 0.9rem 1.5rem;
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }
  .pdf-download {
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.5rem 0.75rem;
  }
  .answer-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 0;
    margin-bottom: 1.5rem;
    border-block: 1px solid var(--border);
    background: var(--background);
  }
  .nav-label {
    flex: none;
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }
  .question-links {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding: 0.15rem 0;
    scrollbar-width: thin;
  }
  .question-links a {
    display: grid;
    place-items: center;
    flex: none;
    min-width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding-inline: 0.45rem;
    font-size: 0.8rem;
  }
  .question-links a:hover,
  .question-links a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  .answer-card {
    position: relative;
    margin-bottom: 2.25rem;
    scroll-margin-top: 5rem;
  }
  .legacy-anchor {
    position: absolute;
    top: 0;
    scroll-margin-top: 5rem;
  }
  .answer-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  h2 {
    font-size: 1rem;
    font-weight: 600;
  }
  .answer-heading a {
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }
  .answer-image-link {
    display: block;
    background: white;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    overflow: hidden;
  }
  .answer-card img {
    display: block;
    width: 100%;
    height: auto;
    background: white;
  }
  .answer-credit {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block: 1rem 1.5rem;
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }
  .reading-footer {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9rem;
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
