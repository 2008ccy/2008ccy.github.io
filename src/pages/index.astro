---
import { getCollection, getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const home = await getEntry("pages", "home");
if (!home) throw new Error("缺少 src/content/pages/home.md");
const { Content } = await render(home);
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter(project => project.data.featured);
const visibleProjects =
  featuredProjects.length > 0 ? featuredProjects : projects;
const posts = getSortedPosts(await getCollection("posts"));
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout
  title={`${home.data.title}｜${config.site.title}`}
  description={home.data.description}
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section class="border-border border-b pt-10 pb-10">
      <p class="text-accent mb-2 font-semibold">个人网站 / Portfolio</p>
      <h1 class="mb-4 text-4xl font-bold sm:text-5xl">{home.data.title}</h1>
      <p class="text-muted-foreground mb-5 text-lg">{home.data.description}</p>
      <div class="app-prose"><Content /></div>
      <div class="mt-5"><Socials /></div>
    </section>

    <section
      class="border-border border-b py-10"
      aria-labelledby="projects-heading"
    >
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2 id="projects-heading" class="text-2xl font-semibold">精选作品</h2>
        <a
          class="text-accent underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "projects")}>全部作品 →</a
        >
      </div>
      {
        visibleProjects.length > 0 ? (
          <ul class="grid gap-4 sm:grid-cols-2">
            {visibleProjects.slice(0, 4).map(project => (
              <li class="border-border rounded-xl border p-5">
                <h3 class="text-xl font-semibold">
                  <a
                    class="hover:text-accent"
                    href={getRelativeLocaleUrl(
                      locale,
                      `projects/${project.id}`
                    )}
                  >
                    {project.data.title}
                  </a>
                </h3>
                <p class="text-muted-foreground mt-2">
                  {project.data.description}
                </p>
                {project.data.status && (
                  <p class="mt-2 text-sm">状态：{project.data.status}</p>
                )}
                <a
                  class="text-accent mt-4 inline-block underline underline-offset-4"
                  href={getRelativeLocaleUrl(locale, `projects/${project.id}`)}
                >
                  查看详情 →
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground">作品正在整理中，欢迎稍后再来。</p>
        )
      }
    </section>

    <section class="py-10" aria-labelledby="posts-heading">
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2 id="posts-heading" class="text-2xl font-semibold">近期文章</h2>
        <a
          class="text-accent underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "posts")}>全部文章 →</a
        >
      </div>
      {
        posts.length > 0 ? (
          <ul>
            {posts.slice(0, config.posts.perIndex).map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground">
            文章正在准备中。之后会在这里分享学习记录。
          </p>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    if (indexLayout?.layout)
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? "/");
  });
</script>
